    {
      "name": "List songs",
      "item": [
        {
          "name": "Happy: lists songs with pagination metadata (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/music/", "host": ["{{baseUrl}}"], "path": ["api", "music", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns a paginated envelope', () => {",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta).to.include.keys('page', 'limit', 'total', 'totalPages');",
                  "});",
                  "pm.test('includes the song created earlier', () => {",
                  "  const ids = body.data.map((song) => song.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get('songId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Happy: filters by artist (200)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/music/?artist=Queen",
              "host": ["{{baseUrl}}"],
              "path": ["api", "music", ""],
              "query": [{ "key": "artist", "value": "Queen" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('every result matches the artist filter', () => {",
                  "  const body = pm.response.json();",
                  "  body.data.forEach((song) => pm.expect(song.artist).to.eql('Queen'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Sad: limit out of range (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/music/?limit=1000",
