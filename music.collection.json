{
  "info": {
    "_postman_id": "2cebdfac-7194-4c69-afdd-7d39209b3ecd",
    "name": "Music Artist API",
    "description": "End-to-end scenarios for the Music Artist API, covering both happy and sad paths for every endpoint. Runs top-to-bottom in one pass: the song created in \"Create song\" is reused (via the {{songId}} collection variable) by the later folders, and is deleted by the end of the \"Delete song\" folder.\n\nRun with the Postman \"Run collection\" button, or headlessly with `npx newman run music.collection.json --env-var baseUrl=http://localhost:3005 --env-var x_api_key=<your key>`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "22118074"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005", "type": "string" },
    { "key": "x_api_key", "value": "replace-with-a-random-secret", "type": "string" },
    { "key": "songId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Create song",
      "item": [
        {
          "name": "Happy: creates a song (201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Bohemian Rhapsody\",\n    \"artist\": \"Queen\",\n    \"imageurl\": \"https://example.com/image.jpg\",\n    \"notes\": \"A classic rock opera ballad.\",\n    \"popularity\": 10\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/music/", "host": ["{{baseUrl}}"], "path": ["api", "music", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('returns the created song with an id', () => {",
                  "  pm.expect(body.id).to.be.a('string');",
                  "  pm.expect(body.name).to.eql('Bohemian Rhapsody');",
                  "  pm.expect(body.created_at).to.exist;",
                  "});",
                  "pm.collectionVariables.set('songId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sad: missing required field (400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{x_api_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"artist\": \"Queen\",\n    \"imageurl\": \"https://example.com/image.jpg\",\n    \"notes\": \"Missing the name field.\",\n    \"popularity\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/music/", "host": ["{{baseUrl}}"], "path": ["api", "music", ""] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
