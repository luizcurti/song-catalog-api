{
  "name": "music",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "eslint": "eslint . --ext .ts",
    "test": "jest --coverage",
    "kill:3005": "lsof -ti:3005 | xargs kill -9 2>/dev/null || echo 'No process running on port 3005'",
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules -r tsconfig-paths/register src/shared/infra/server.ts",
    "dev:clean": "npm run kill:3005 && npm run dev",
    "typeorm": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -f src/shared/infra/database/config/ormconfig.ts",
    "typeorm:show": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -f src/shared/infra/database/config/ormconfig.ts",
    "typeorm:revert": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -f src/shared/infra/database/config/ormconfig.ts",
    "typeorm:sync": "npx ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js schema:sync -f src/shared/infra/database/config/ormconfig.ts",
    "build": "tsc",
    "start": "NODE_ENV=production node -r module-alias/register dist/shared/infra/server.js",
    "start:clean": "npm run kill:3005 && npm run start"
  },
  "author": "Luiz Curti",
  "license": "ISC",
  "_moduleAliases": {
    "@config": "dist/config",
    "@shared": "dist/shared",
    "@modules": "dist/modules",
    "@errors": "dist/errors",
    "@utils": "dist/utils"
  },
  "dependencies": {
    "@types/uuid": "^9.0.1",
    "axios": "^1.3.4",
    "cors": "^2.8.5",
    "dotenv": "^14.3.2",
    "express": "^4.17.2",
    "express-async-errors": "^3.1.1",
    "express-handlebars": "^7.0.4",
    "helmet": "^6.0.1",
    "module-alias": "^2.2.3",
    "mysql2": "^3.14.0",
    "redis": "^3.1.2",
    "routes": "^2.1.0",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.7.0",
    "typeorm": "^0.2.40",
    "uuid": "^9.0.0",
    "yup": "^1.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.11",
    "@types/redis": "^2.8.32",
    "@types/validator": "^13.7.14",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.5.0",
    "supertest": "^6.2.2",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.2"
  }
}
