{
  "name": "song-catalog-api",
  "version": "1.0.0",
  "description": "REST API for managing a song catalog, built with TypeScript, Express, TypeORM, and Redis.",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/luizcurti/song-catalog-api.git"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "eslint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --selectProjects unit --watch",
    "kill:3005": "lsof -ti:3005 | xargs kill -9 2>/dev/null || echo 'No process running on port 3005'",
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules -r tsconfig-paths/register src/shared/infra/server.ts",
    "dev:clean": "npm run kill:3005 && npm run dev",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/shared/infra/database/dataSource.ts",
    "typeorm:show": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:show -d src/shared/infra/database/dataSource.ts",
    "typeorm:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/shared/infra/database/dataSource.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node -r module-alias/register dist/shared/infra/server.js",
    "start:clean": "npm run kill:3005 && npm run start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:diagrams": "sh scripts/generate-diagrams.sh",
    "prepare": "husky"
  },
  "author": "Luiz Curti",
  "license": "ISC",
  "_moduleAliases": {
    "@config": "dist/config",
    "@shared": "dist/shared",
    "@modules": "dist/modules",
    "@errors": "dist/errors"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "module-alias": "^2.3.4",
    "mysql2": "^3.23.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.31",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,yaml,json}": [
      "prettier --write"
    ]
  }
}
